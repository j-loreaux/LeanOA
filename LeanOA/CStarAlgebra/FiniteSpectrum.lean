namespace ContinuousMapZero

lemma eq_sum_smul_single_of_finite [DiscreteTopology A] [Fintype A] [Zero A]
    [DecidableEq A] (f : C(A, 𝕜)₀) :
    f = ∑ i, f i • single i 1 := by
  aesop (add simp [Pi.single_apply])

@[simp] lemma mem_span_isStarProjection_of_finite [DiscreteTopology A] [Finite A] [Zero A]
    (f : C(A, 𝕜)₀) : f ∈ Submodule.span 𝕜 {p : C(A, 𝕜)₀ | IsStarProjection p} := by
  have := Fintype.ofFinite A
  classical
  rw [eq_sum_smul_single_of_finite f]
  exact Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ <| Submodule.mem_span_of_mem
    (by constructor <;> ext <;> simp_all [Pi.single_apply, apply_ite])

variable (𝕜) in
@[simp]
lemma isStarProjection_single [DiscreteTopology A] [Zero A] [DecidableEq A] (i : A) :
    IsStarProjection (single i (1 : 𝕜)) := by
  constructor <;> ext <;> simp_all [Pi.single_apply, apply_ite]

/-- A nonnegative function on a finite discrete space lies in the cone generated by star
projections. -/
lemma mem_hull_isStarProjection_of_finite [DiscreteTopology A] [Finite A] [Zero A]
    (f : C(A, ℝ)₀) (hf : 0 ≤ f) : f ∈ ConvexCone.hull ℝ {p : C(A, ℝ)₀ | IsStarProjection p} := by
  have := Fintype.ofFinite A
  classical
  rw [eq_sum_smul_single_of_finite f]
  let K := PointedCone.hull ℝ {p : C(A, ℝ)₀ | IsStarProjection p}
  have hi (i : A) : f i • single i 1 ∈ K := K.smul_mem (hf i) <| PointedCone.subset_hull <| by simp
  rw [← PointedCone.toConvexCone_hull_of_zero_mem (.zero _), PointedCone.mem_toConvexCone]
  induction (Finset.univ : Finset A) using Finset.induction_on with
  | empty => simp
  | insert => aesop

end ContinuousMapZero

variable (A) in
/-- A C⋆-algebra is **FS (Finite Spectrum)** if the set of self-adjoint elements has a dense subset
of elements with finite spectrum. -/
@[mk_iff]
class CStarAlgebra.FiniteSpectrum [NonUnitalRing A] [Module ℝ A] [Star A] : Prop where
  fs : {x : A | IsSelfAdjoint x} ⊆ closure {x : A | IsSelfAdjoint x ∧ (quasispectrum ℝ x).Finite}

theorem CStarAlgebra.finiteSpectrum_iff_spectrum [Ring A] [Algebra ℝ A] [Star A] :
    CStarAlgebra.FiniteSpectrum A ↔
      {x : A | IsSelfAdjoint x} ⊆ closure {x | IsSelfAdjoint x ∧ (spectrum ℝ x).Finite} := by
  simp [quasispectrum_eq_spectrum_union_zero, CStarAlgebra.finiteSpectrum_iff]

instance [NonUnitalRing A] [Module ℝ A] [Star A] [Subsingleton A] :
    CStarAlgebra.FiniteSpectrum A where
  fs := by simp [Subsingleton.eq_zero]

open ContinuousMap LocallyConstant in
/-- The continuous functions on a compact totally separated space form an FS C⋆-algebra. This is a
form of Sakai 1.3.1. -/
instance ContinuousMap.instFiniteSpectrum [TotallySeparatedSpace A] [CompactSpace A] :
    CStarAlgebra.FiniteSpectrum C(A, 𝕜) :=
  CStarAlgebra.finiteSpectrum_iff_spectrum.mpr fun x hx ↦ by
    obtain ⟨y, rfl⟩ := range_realToRCLike_eq_isSelfAdjoint A 𝕜 ▸ hx
    have : realToRCLike 𝕜 '' {x : C(A, ℝ) | IsSelfAdjoint x ∧ (spectrum ℝ x).Finite} ⊆
      {x | IsSelfAdjoint x ∧ (spectrum ℝ x).Finite} := by aesop
    refine closure_mono this
      (mem_closure_image (isometry_realToRCLike A 𝕜).continuous.continuousAt ?_)
    have : .range toContinuousMap ⊆ {x : C(A, ℝ) | IsSelfAdjoint x ∧ (spectrum ℝ x).Finite} :=
      fun _ ⟨f, hf⟩ ↦ by simp [← hf, spectrum_eq_range, range_finite, IsSelfAdjoint]
    apply closure_mono this
    simpa using! Subalgebra.ext_iff.mp (subalgebra_topologicalClosure_eq_top_of_separatesPoints _
      (separatesPoints_range_toContinuousMapAlgHom ℝ)) y

variable [NonUnitalRing A] [StarRing A] [Module ℝ A] [IsScalarTower ℝ A A] [SMulCommClass ℝ A A]
  [NonUnitalContinuousFunctionalCalculus ℝ A IsSelfAdjoint]

/-- A self-adjoint element with finite quasispectrum in a non-unital C⋆-algebra is in the span of
star projections. -/
lemma IsSelfAdjoint.mem_span_isStarProjection_of_finite_quasispectrum {x : A}
    (hx : IsSelfAdjoint x) (h : (quasispectrum ℝ x).Finite) :
    x ∈ Submodule.span ℝ {p : A | IsStarProjection p} := by
  have : Finite (quasispectrum ℝ x) := Set.finite_coe_iff.mpr h
  refine Submodule.mem_span.mpr fun p hp ↦ ?_
  simpa [cfcₙHom_id] using Submodule.mem_span.mp
    (ContinuousMapZero.id (quasispectrum ℝ x)).mem_span_isStarProjection_of_finite
    (.comap (cfcₙHom (R := ℝ) hx : _ →ₗ[ℝ] A) p)
    (by simp_all [Set.subset_def, IsStarProjection.map])

/-- In a FS C⋆-algebra, the topological closure of the span of star
projections is exactly the submodule of the self-adjoint elements. -/
@[simp] theorem CStarAlgebra.FiniteSpectrum.topologicalClosure_span_isStarProjection
    [ContinuousConstSMul ℝ A] [ContinuousAdd A] [StarModule ℝ A] [T2Space A]
    [ContinuousStar A] [h : CStarAlgebra.FiniteSpectrum A] :
    (Submodule.span ℝ {x : A | IsStarProjection x}).topologicalClosure =
      selfAdjoint.submodule ℝ A := by
  refine le_antisymm (fun x hx ↦ closure_minimal (fun x hx ↦ ?_) ?_ hx) fun x hx ↦ ?_
  · refine Submodule.span_induction (fun _ hx ↦ hx.isSelfAdjoint) ?_ ?_ ?_ hx <;> aesop
  · exact isClosed_eq continuous_id'.star continuous_id'
  · exact closure_mono (fun y hy ↦ hy.1.mem_span_isStarProjection_of_finite_quasispectrum hy.2)
      (h.fs hx)

open scoped ComplexStarModule in
open Submodule in
/-- In an FS C⋆-algebra, the complex span of the star projections is dense. -/
theorem CStarAlgebra.FiniteSpectrum.topologicalClosure_span_complex_isStarProjection {A : Type*}
    [NonUnitalRing A] [StarRing A] [Module ℂ A] [IsScalarTower ℂ A A] [SMulCommClass ℂ A A]
    [TopologicalSpace A]
    [NonUnitalContinuousFunctionalCalculus ℂ A IsStarNormal]
    [ContinuousConstSMul ℂ A] [ContinuousAdd A] [StarModule ℂ A] [T2Space A]
    [ContinuousStar A] [h : CStarAlgebra.FiniteSpectrum A] :
    (span ℂ {p : A | IsStarProjection p}).topologicalClosure = ⊤ := by
  have h {y : A} (hy : IsSelfAdjoint y) :
      y ∈ (span ℂ {p : A | IsStarProjection p}).topologicalClosure :=
    closure_mono (span_le_restrictScalars ℝ ℂ _) <| topologicalClosure_span_isStarProjection.ge hy
  refine eq_top_iff.mpr fun x _ ↦ ?_
  rw [← realPart_add_I_smul_imaginaryPart x]
  aesop

open ConvexCone in
/-- A nonnegative element with finite quasispectrum lies in the cone generated by star
projections. -/
lemma mem_hull_isStarProjection_of_nonneg_of_finite_quasispectrum
    [PartialOrder A] [StarOrderedRing A] [NonnegSpectrumClass ℝ A] {x : A} (hx₀ : 0 ≤ x)
    (h : (σₙ ℝ x).Finite) :
    x ∈ hull ℝ {p : A | IsStarProjection p} := by
  have : Finite (σₙ ℝ x) := h.to_subtype
  have hx := hx₀.isSelfAdjoint
  have hmap : hull ℝ {p : C(σₙ ℝ x, ℝ)₀ | IsStarProjection p} ≤
      (hull ℝ {p : A | IsStarProjection p}).comap (cfcₙHom (R := ℝ) hx : _ →ₗ[ℝ] A) :=
    hull_min fun p hp ↦ subset_hull (hp.map <| cfcₙHom hx)
  have hid : (0 : C(σₙ ℝ x, ℝ)₀) ≤ .id _ :=
    fun r ↦ quasispectrum_nonneg_of_nonneg (𝕜 := ℝ) x hx₀ r r.2
  simpa [cfcₙHom_id] using hmap ((ContinuousMapZero.id _).mem_hull_isStarProjection_of_finite hid)

open scoped ComplexStarModule in
/-- Being FS passes to quotients: it transfers along a surjective star homomorphism. -/
theorem CStarAlgebra.FiniteSpectrum.of_surjective {B C : Type*} [NonUnitalCStarAlgebra B]
    [NonUnitalCStarAlgebra C] [CStarAlgebra.FiniteSpectrum C] (φ : C →⋆ₙₐ[ℂ] B)
    (hφ : Function.Surjective φ) :
    CStarAlgebra.FiniteSpectrum B where
  fs y hy := by
    obtain ⟨x, rfl⟩ := hφ y
    have hmap : Set.MapsTo φ {x : C | IsSelfAdjoint x ∧ (σₙ ℝ x).Finite}
        {x : B | IsSelfAdjoint x ∧ (σₙ ℝ x).Finite} := fun x hx ↦
      ⟨hx.1.map φ, hx.2.subset <| NonUnitalAlgHom.quasispectrum_apply_subset' ℂ φ x⟩
    have hx : φ (ℜ x) = φ x := by rw [map_realPart, hy.coe_realPart]
    simpa [hx] using map_mem_closure (map_continuous φ) (fs (ℜ x).2) hmap

/-- Being FS transfers backwards along a star algebra equivalence. -/
theorem CStarAlgebra.FiniteSpectrum.of_starAlgEquiv {B C : Type*} [NonUnitalCStarAlgebra B]
    [NonUnitalCStarAlgebra C] [CStarAlgebra.FiniteSpectrum C] (e : B ≃⋆ₐ[ℂ] C) :
    CStarAlgebra.FiniteSpectrum B :=
  .of_surjective (e.symm : C →⋆ₙₐ[ℂ] B) e.symm.surjective

section CStarAlgebra

variable {B : Type*} [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]
  [hB : CStarAlgebra.FiniteSpectrum B]

/-- In an FS C⋆-algebra, every nonnegative element is a norm limit of nonnegative linear
combinations of star projections. -/
theorem CStarAlgebra.FiniteSpectrum.mem_closure_hull_isStarProjection {x : B} (hx : 0 ≤ x) :
    x ∈ closure (ConvexCone.hull ℝ {p : B | IsStarProjection p} : Set B) := by
  /- Approximate `x` by selfadjoint elements `y` with finite spectrum; their positive parts
  `y⁺ = 2⁻¹ • (|y| + y)` are nonnegative, have finite spectrum, and depend continuously on `y`. -/
  rw [← (CFC.posPart_eq_self x).mpr hx, ← hx.isSelfAdjoint.posPartRetract]
  refine map_mem_closure (by fun_prop) (hB.fs hx.isSelfAdjoint) fun y hy ↦ ?_
  rw [hy.1.posPartRetract]
  refine mem_hull_isStarProjection_of_nonneg_of_finite_quasispectrum (CFC.posPart_nonneg y) ?_
  rw [CFC.posPart_def, cfcₙ_map_quasispectrum (·⁺) y]
  exact hy.2.image _

/-- To compare positive linear maps from an FS C⋆-algebra on nonnegative elements, it suffices to
compare them on star projections. -/
theorem PositiveLinearMap.le_of_le_on_isStarProjection {C : Type*} [NonUnitalCStarAlgebra C]
    [PartialOrder C] [StarOrderedRing C] (φ ψ : B →ₚ[ℂ] C)
    (h : ∀ p : B, IsStarProjection p → φ p ≤ ψ p) {x : B} (hx : 0 ≤ x) : φ x ≤ ψ x := by
  let K : ConvexCone ℝ B :=
    { carrier := {x | φ x ≤ ψ x}
      smul_mem' c hc x hx := by
        simpa only [Set.mem_ofPred_eq, map_smul_of_tower] using smul_le_smul_of_nonneg_left hx hc.le
      add_mem' {x} hx {y} hy := by simpa only [Set.mem_ofPred_eq, map_add] using add_le_add hx hy }
  refine closure_minimal (ConvexCone.hull_min (C := K) fun p hp ↦ h p hp) ?_
    (CStarAlgebra.FiniteSpectrum.mem_closure_hull_isStarProjection hx)
  exact isClosed_le (map_continuous φ) (map_continuous ψ)

end CStarAlgebra
