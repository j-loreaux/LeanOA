module

public import LeanOA.Mathlib.Topology.ContinuousMap.LocallyConstant
public import Mathlib.Analysis.CStarAlgebra.GelfandDuality
public import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Order
public import Mathlib.Analysis.CStarAlgebra.Hom
public import Mathlib.Analysis.RCLike.ContinuousMap
public import Mathlib.Topology.ContinuousMap.StarOrdered

@[expose] public section

/-! # Approximation by projections in commutative C⋆-algebras

If the character space of a unital commutative C⋆-algebra `A` is totally separated (e.g., if it
is extremally disconnected, as happens for maximal abelian subalgebras of W⋆-algebras), then
every nonnegative element of `A` is a norm limit of nonnegative linear combinations of
projections. This is Sakai 1.3.1, transferred along the Gelfand transform.
-/

open scoped NNReal ComplexOrder
open WeakDual

variable {A : Type*} [CommCStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

/-- If the character space of a unital commutative C⋆-algebra is totally separated, then every
nonnegative element is a norm limit of nonnegative linear combinations of projections. -/
theorem CommCStarAlgebra.mem_closure_span_isStarProjection_of_nonneg
    [TotallySeparatedSpace (characterSpace ℂ A)] {a : A} (ha : 0 ≤ a) :
    a ∈ closure (Submodule.span ℝ≥0 {p : A | IsStarProjection p} : Set A) := by
  /- Let `Φ : C(characterSpace ℂ A, ℝ) → A` be the inverse Gelfand transform precomposed with
  the inclusion of real functions into complex ones. Then `Φ` is continuous, sends idempotents
  to projections, and `a = Φ f` for some nonnegative `f`. -/
  let e := gelfandStarTransform A
  let Φ : C(characterSpace ℂ A, ℝ) →⋆ₐ[ℝ] A :=
    (e.symm : C(characterSpace ℂ A, ℂ) →⋆ₐ[ℂ] A).restrictScalars ℝ |>.comp
      (ContinuousMap.realToRCLikeStarAlgHom _ ℂ)
  have hΦ : Continuous Φ := (StarAlgEquiv.isometry e.symm).continuous.comp
    (ContinuousMap.continuous_realToRCLike (X := characterSpace ℂ A) (𝕜 := ℂ))
  let f := (e a).rclikeToReal
  have hsa : IsSelfAdjoint (e a) := ha.isSelfAdjoint.map e
  have hfa : Φ f = a := by
    change e.symm ((e a).rclikeToReal.realToRCLike ℂ) = a
    rw [ContinuousMap.IsSelfAdjoint.realToRCLike_rclikeToReal hsa, StarAlgEquiv.symm_apply_apply]
  have hf : 0 ≤ f := by
    convert ContinuousMap.rclikeToReal_monotone (X := characterSpace ℂ A) (𝕜 := ℂ)
      (map_nonneg e ha) using 1
    ext; simp
  rw [← hfa]
  refine map_mem_closure hΦ (ContinuousMap.mem_closure_span_isIdempotentElem_of_nonneg hf) ?_
  /- `Φ` maps the cone generated by the idempotents into the cone generated by projections. -/
  let L : C(characterSpace ℂ A, ℝ) →ₗ[ℝ≥0] A := Φ.toLinearMap.restrictScalars ℝ≥0
  intro x hx
  refine (Submodule.map_span_le L _ _).mpr (fun y (hy : IsIdempotentElem y) ↦ ?_) ⟨x, hx, rfl⟩
  exact Submodule.subset_span
    (show IsStarProjection (Φ y) from ⟨hy.map Φ, (IsSelfAdjoint.all y).map Φ⟩)
